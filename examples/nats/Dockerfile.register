# The quik-register sidecar agent, built from the workspace. Build context is
# the repo root.
FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p quik-register

FROM debian:bookworm-slim
# ca-certificates for tls:// NATS / https health checks in real deployments.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/quik-register /usr/local/bin/quik-register
ENTRYPOINT ["quik-register", "--config", "/etc/quik-register/quik-register.toml"]
