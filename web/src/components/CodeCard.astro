---
import { Icon } from "astro-icon/components";

interface Props {
  /** Filename or caption shown in the header bar. */
  caption: string;
  /** lucide icon name, e.g. "lucide:terminal". */
  icon?: string;
  /** Raw code to render. */
  code: string;
  /** Show the three traffic-light dots (terminal chrome). */
  dots?: boolean;
  class?: string;
}

const {
  caption,
  icon = "lucide:terminal",
  code,
  dots = false,
  class: className = "",
} = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-2xl border border-white/10 bg-black/40",
    className,
  ]}
>
  <div
    class="flex items-center justify-between border-b border-white/10 px-4 py-3 text-xs text-slate-400"
  >
    <span class="flex items-center gap-2">
      <Icon name={icon} class="h-3.5 w-3.5 text-cyan-300" />
      {caption}
    </span>
    {
      dots && (
        <span class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-white/20" />
          <span class="h-2.5 w-2.5 rounded-full bg-white/20" />
          <span class="h-2.5 w-2.5 rounded-full bg-cyan-300/70" />
        </span>
      )
    }
  </div>
  <pre
    class="overflow-x-auto p-4 text-[12.5px] leading-6 text-slate-200 md:p-5"><code>{code}</code></pre>
</div>
