---
import { Icon } from "astro-icon/components";
import Wordmark from "../components/Wordmark.astro";
import { GITHUB_URL, NAV_LINKS } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "quik.sh - a small, fast reverse proxy in Rust",
  description = "An open-source reverse proxy in Rust: TLS termination, HTTP/1.1 and HTTP/2, host and path routing, JWT auth, and health-checked load balancing. One small binary, one TOML file.",
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith("/") && !href.includes("#") && path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/quik-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-[#05070d] text-white">
    <div class="pointer-events-none fixed inset-0">
      <div
        class="absolute left-1/2 top-[-22rem] h-[44rem] w-[44rem] -translate-x-1/2 rounded-full bg-cyan-400/20 blur-3xl"
      >
      </div>
      <div
        class="absolute right-[-16rem] top-48 h-[34rem] w-[34rem] rounded-full bg-blue-700/20 blur-3xl"
      >
      </div>
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.045)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.045)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_at_top,black_35%,transparent_80%)]"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
      <nav class="flex items-center justify-between py-6">
        <Wordmark />

        <div class="hidden items-center gap-7 text-sm text-slate-400 md:flex">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                class:list={[
                  "hover:text-white",
                  isActive(link.href) && "text-white",
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-4 py-2 text-sm font-medium text-white backdrop-blur-xl hover:bg-white/10"
        >
          <Icon name="lucide:github" class="h-4 w-4" />
          GitHub
        </a>
      </nav>

      <slot />

      <footer
        class="flex flex-col gap-4 border-t border-white/10 py-8 text-sm text-slate-500 md:flex-row md:items-center md:justify-between"
      >
        <Wordmark />
        <div>Written in Rust · MIT licensed · single ~5 MB binary</div>
      </footer>
    </div>
  </body>
</html>
